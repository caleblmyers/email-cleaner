# Copy this file to .env and fill in your values

# Required: Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Required: Random secret for signing session cookies (use a long random string)
SESSION_SECRET_KEY=change-me-to-a-random-32-char-string

# Optional settings (defaults shown)
APP_PORT=8000
EMAILS_PER_PAGE=50
CLASSIFIER_BATCH_SIZE=20
SAVE_DIR=./saved_emails
LOG_LEVEL=INFO
SESSION_MAX_AGE=3600
